# ════════════════════════════════════════════════════════════════
# aml_niche_net — track only code, small summary tables, figures, docs.
# Large objects stay on disk, never in version control (/LARGE1 is outside the repo).
# ════════════════════════════════════════════════════════════════

# ── Large data: exclude by extension ──────────────────────────────
*.rds
*.RDS
*.h5ad
*.h5
*.loom
*.mtx
*.bam
*.bam.*
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.csv.gz

# ── Leftover downloads / one-off scratch ──────────────────────────
/SRR*/
/Rplots.pdf
/omnipathr-log/
/00_project/tmp/

# ── Logs: exclude all (370 active + 85 archived) ──────────────────
/logs/
/00_project/logs/
scripts/以前06_hierarchy/logs/
*.out
*.err

# ── results: keep small summary tables, drop per-sample outputs ────
# 02_malignancy: 9 per-dataset subdirs (265 files / 49M)
/results/tables/02_malignancy/*/
# 05_ccc: 148 per-sample CellChat LR tensors
/results/tables/05_ccc/tensors/
# permutation null (401K binary, regenerated on every rerun)
/results/tables/08_scoring/block_null.npz
# generated lab-meeting deck (~1.3M base64-embedded HTML; rebuild via
# scripts/10_figures/build_lab_meeting_deck.py from the tracked template + figures)
/results/figures/12_deck/lab_meeting_deck.html

# ── Frozen v1 run (2026-07-15 pipeline output, kept for the v1-vs-v2 comparison) ──
# 161M / 581 files. Regenerable only by re-running the OLD config, so it lives on disk, not in
# git. The LARGE1 side of the same snapshot is 99_archive/v1_2026-07-29 (22G).
/results_v1/

# ── Editor / runtime ──────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
.Renviron
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# ── Agent local config (personal permission settings, not shared) ──
.claude/settings.local.json

# ── Auto-commit script's own log (else it self-triggers infinitely) ──
/00_project/git_autocommit.log

# ── Insurance: never let the private coaching/career notes into a PUBLIC repo ──
*handoff*.md
career_*.md

# Snakemake bookkeeping (DAG state, per-run logs). Regenerated; never a result.
.snakemake/
logs/snakemake/
