# ════════════════════════════════════════════════════════════════
# aml_niche_net — 只 track 代码、小汇总表、图、文档
# 大对象一律留在磁盘上，不进版本库（/LARGE1 本来就在仓库外）
# ════════════════════════════════════════════════════════════════

# ── 大数据：按扩展名一律排除 ──────────────────────────────
*.rds
*.RDS
*.h5ad
*.h5
*.loom
*.mtx
*.bam
*.bam.*
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.csv.gz

# ── 遗留下载 / 一次性临时产物 ─────────────────────────────
/SRR*/
/Rplots.pdf
/omnipathr-log/
/00_project/tmp/

# ── 日志：全部排除（370 个 + 归档 85 个）──────────────────
/logs/
/00_project/logs/
scripts/以前06_hierarchy/logs/
*.out
*.err

# ── results：保留小汇总表，排除 per-sample 逐样本产物 ──────
# 02_malignancy 的 9 个数据集子目录（265 个文件 / 49M）
/results/tables/02_malignancy/*/
# 05_ccc 的 148 个 CellChat LR 张量
/results/tables/05_ccc/tensors/
# 置换零分布（401K 二进制，每次重跑都会重新生成）
/results/tables/08_scoring/block_null.npz

# ── 编辑器 / 运行时 ───────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
.Renviron
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# ── agent 本地配置（个人权限设置，不共享）─────────────────
.claude/settings.local.json
