# ════════════════════════════════════════════════════════════════
# aml_niche_net — track only code, small summary tables, figures, docs.
# Large objects stay on disk, never in version control (/LARGE1 is outside the repo).
# ════════════════════════════════════════════════════════════════

# ── Large data: exclude by extension ──────────────────────────────
*.rds
*.RDS
*.h5ad
*.h5
*.loom
*.mtx
*.bam
*.bam.*
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.csv.gz

# ── Leftover downloads / one-off scratch ──────────────────────────
/SRR*/
/Rplots.pdf
/omnipathr-log/
/00_project/tmp/

# ── Logs: exclude all (370 active + 85 archived) ──────────────────
/logs/
/00_project/logs/
scripts/以前06_hierarchy/logs/
*.out
*.err

# ── results: keep small summary tables, drop per-sample outputs ────
# 02_malignancy: 9 per-dataset subdirs (265 files / 49M)
/results/tables/02_malignancy/*/
# 05_ccc: 148 per-sample CellChat LR tensors
/results/tables/05_ccc/tensors/
# permutation null (401K binary, regenerated on every rerun)
/results/tables/08_scoring/block_null.npz

# ── Editor / runtime ──────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
.Renviron
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# ── Agent local config (personal permission settings, not shared) ──
.claude/settings.local.json

# ── Auto-commit script's own log (else it self-triggers infinitely) ──
/00_project/git_autocommit.log
